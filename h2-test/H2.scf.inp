&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'H2',
  tstress = .true.,
  tprnfor = .true.,
  pseudo_dir = './pseudo/',
  outdir = './qe-out/'
/
&SYSTEM
  ibrav = 1,
  celldm(1) = 10.0,
  nat = 2,
  ntyp = 1,
  ecutwfc = 20,
/
&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_mode = 'plain',
  diagonalization = 'david',
/
ATOMIC_SPECIES
  H  1.00794  H_US.van
ATOMIC_POSITIONS bohr
  H  -0.7  0.0  0.0
  H   0.7  0.0  0.0
K_POINTS automatic
  1 1 1  0 0 0
