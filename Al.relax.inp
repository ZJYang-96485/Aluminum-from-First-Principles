&CONTROL
  calculation = 'vc-relax',
  restart_mode = 'from_scratch',
  prefix = 'aluminum_relax',
  tstress = .true.,
  tprnfor = .true.,
  pseudo_dir = '/Users/zhy/Aluminum-from-First-Principles/',
  outdir = '/Users/zhy/Aluminum-from-First-Principles/qe-out/a3-relax/'
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 9.0,
  nat = 1,
  ntyp = 1,
  ecutwfc = 35.0,
  ecutrho = 280.0,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.01,
/
&ELECTRONS
  diagonalization = 'david',
  mixing_mode = 'plain',
  conv_thr = 1.0d-8
/
&IONS
/
&CELL
/
ATOMIC_SPECIES
 Al  26.982  Al.pbe-n-van.UPF
ATOMIC_POSITIONS alat
 Al 0.00 0.00 0.00
K_POINTS automatic
  16 16 16  0 0 0
