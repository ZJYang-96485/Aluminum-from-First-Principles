&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'lda_cutoff_ecut-070p0-ry_k-16x16x16_degauss-0p010-ry',
  tstress = .true.,
  tprnfor = .true.,
  pseudo_dir = '/Users/zhy/Aluminum-from-First-Principles/',
  outdir = '/Users/zhy/Aluminum-from-First-Principles/lda-convergence-runs/cutoff/ecut-070.0-ry_k-16x16x16_degauss-0.010-ry/qe-out/'
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 7.6000000000,
  nat = 1,
  ntyp = 1,
  input_dft = 'PZ',
  ecutwfc = 70.000000,
  ecutrho = 280.000000,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.010000
/
&ELECTRONS
  diagonalization = 'david',
  mixing_mode = 'plain',
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
  Al  26.982  Al.pz-vbc.UPF
ATOMIC_POSITIONS alat
  Al  0.00  0.00  0.00
K_POINTS automatic
  16 16 16  0 0 0
