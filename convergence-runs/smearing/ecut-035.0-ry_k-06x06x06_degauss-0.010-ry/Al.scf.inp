&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'aluminum_ecut-035p0-ry_k-06x06x06_degauss-0p010-ry',
  tstress = .true.,
  tprnfor = .true.,
  pseudo_dir = '/Users/zhy/Aluminum-from-First-Principles/',
  outdir = '/Users/zhy/Aluminum-from-First-Principles/convergence-runs/smearing/ecut-035.0-ry_k-06x06x06_degauss-0.010-ry/qe-out/'
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 9.0,
  nat = 1,
  ntyp = 1,
  ecutwfc = 35.000000,
  ecutrho = 280.000000,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.010000
/
&ELECTRONS
  diagonalization = 'david',
  mixing_mode = 'plain',
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
  Al  26.982  Al.pbe-n-van.UPF
ATOMIC_POSITIONS alat
  Al  0.00  0.00  0.00
K_POINTS automatic
  6 6 6  0 0 0
