&CONTROL
  calculation = 'scf',
  restart_mode = 'from_scratch',
  prefix = 'aluminum_a5_bands',
  pseudo_dir = '/Users/zhy/Aluminum-from-First-Principles/',
  outdir = '/Users/zhy/Aluminum-from-First-Principles/qe-out/a5-bands/'
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 7.6060774483,
  nat = 1,
  ntyp = 1,
  ecutwfc = 35.0,
  ecutrho = 280.0,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.01
/
&ELECTRONS
  diagonalization = 'david',
  conv_thr = 1.0d-10,
  mixing_mode = 'plain'
/
ATOMIC_SPECIES
  Al  26.982  Al.pbe-n-van.UPF
ATOMIC_POSITIONS alat
  Al  0.00  0.00  0.00
K_POINTS automatic
  16 16 16  0 0 0
