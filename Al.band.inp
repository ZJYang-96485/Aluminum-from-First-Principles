&CONTROL
  calculation='bands'
  verbosity = 'high'
  prefix='aluminum',
  pseudo_dir = './',
  outdir = './qe-out/'
/
&SYSTEM
  ibrav= 2, 
  celldm(1)= 9.0, 
  nat=  1, 
  ntyp= 1,
  ecutwfc = 15.0,
  occupations = 'smearing',
  smearing = 'methfessel-paxton',
  degauss = 0.05,
  nbnd=8
/
&ELECTRONS
  diagonalization='david'
  mixing_mode = 'plain'
  conv_thr =  1.0d-8
/
